---
import { render } from "astro:content";
import Layout from "@layouts/layout.astro";
import Callout from "@components/guide/callout.astro";
import { getSortedGuides } from "@lib/guides";

export async function getStaticPaths() {
  const guides = await getSortedGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const dateFormat = new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" });
---

<Layout pageTitle={guide.data.title}>
  <article class="mx-auto w-full max-w-3xl py-4">
    <a href="/guide/" class="text-sm text-muted-foreground hover:underline">
      ← 記事一覧
    </a>
    <header class="mt-3 mb-6 border-b pb-4">
      <h1 class="text-3xl font-bold tracking-tight">{guide.data.title}</h1>
      {
        guide.data.description && (
          <p class="mt-2 text-muted-foreground">{guide.data.description}</p>
        )
      }
      {
        guide.data.updatedAt && (
          <p class="mt-2 text-xs text-muted-foreground">
            更新日 {dateFormat.format(guide.data.updatedAt)}
          </p>
        )
      }
    </header>
    <div class="prose prose-neutral max-w-none prose-headings:scroll-mt-4 prose-table:text-sm">
      <Content components={{ Callout }} />
    </div>
  </article>
</Layout>
