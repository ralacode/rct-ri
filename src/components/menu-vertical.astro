---
import {
  ClipboardList,
  ContactRound,
  Contact,
  Search,
  TrendingDown,
} from "@lucide/astro";
import MyIcon from "@components/my-icon.astro";
import { Home } from "lucide-react";

interface Props {
  className?: string;
}

const { className } = Astro.props;

const { pathname } = Astro.url;

const menuItems = [
  { name: "ホーム", href: "/", icon: Home },
  { name: "検査一覧", href: "/exam_order/daily-list/", icon: ClipboardList },
  { name: "患者登録", href: "/patient/register/", icon: ContactRound },
  { name: "患者一覧", href: "/patient/list/", icon: Contact },
  { name: "患者検索", href: "/patient/search/", icon: Search },
  { name: "減衰計算", href: "/mo99-decay/", icon: TrendingDown },
];
---

<ul class:list={["grid gap-4 content-start", { className }]}>
  {
    menuItems.map((item) => {
      const isCurrent =
        pathname === item.href ||
        (item.href !== "/" && pathname.startsWith(item.href));

      return (
        <li class="text-white">
          <a
            href={item.href}
            data-nav-href={item.href}
            class:list={[
              "px-2 py-3 rounded-md",
              "grid grid-cols-[auto,1fr] grid-flow-col gap-4 justify-start items-center",
              {
                // カレント（選択中）のスタイル
                "bg-gray-600": isCurrent,
                // 通常時のスタイル
                "hover:bg-gray-600": !isCurrent,
              },
            ]}
          >
            <MyIcon icon={item.icon} />
            <span>{item.name}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<script>
  function syncCurrentNav() {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-href]").forEach((link) => {
      const href = link.dataset.navHref ?? "";
      const isCurrent =
        path === href || (href !== "/" && path.startsWith(href));
      link.classList.toggle("bg-gray-600", isCurrent);
      link.classList.toggle("hover:bg-gray-600", !isCurrent);
    });
  }

  syncCurrentNav();
  if (!window.__rctNavCurrentInit) {
    window.__rctNavCurrentInit = true;
    document.addEventListener("astro:page-load", syncCurrentNav);
  }
</script>
