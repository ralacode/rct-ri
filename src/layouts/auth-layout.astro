---
import Meta from "@components/meta.astro";
import { siteMeta } from "@lib/constants";
import { getPageTitle } from "@lib/utils";
import { ClientRouter } from "astro:transitions";
import "@styles/global.css";

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
const title = getPageTitle(pageTitle);
---

<!doctype html>
<html lang={siteMeta.siteLocale} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <Meta title={title} />
  </head>
  <body class="min-h-svh bg-background text-foreground">
    <main class="mx-auto flex min-h-svh max-w-md items-center px-4 py-8">
      <slot />
    </main>
  </body>
</html>
