---
// src/layouts/layout.astro

import { AppShell } from "@/components/react/app-shell";
import Meta from "@components/meta.astro";
import { siteMeta } from "@lib/constants";
import { getPageTitle } from "@lib/utils";
import { ClientRouter } from "astro:transitions";
import "@styles/global.css";

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

const title = getPageTitle(pageTitle);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={siteMeta.siteLocale} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <Meta title={title} />
  </head>
  <body
    class="grid h-svh overflow-hidden grid-cols-[auto_1fr] grid-rows-[auto_1fr] [grid-template-areas:'sidebar_header'_'sidebar_main'] print:block print:h-auto print:overflow-visible"
  >
    <AppShell client:load currentPath={currentPath} />
    <main
      id="main-scroll-area"
      class="@container min-h-0 overflow-x-hidden overflow-y-auto px-2 pb-2 [grid-area:main] md:px-6 md:pb-6 print:col-span-full print:overflow-visible print:bg-white print:p-0"
    >
      <slot />
    </main>
  </body>
</html>
