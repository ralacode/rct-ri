{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-ui",
  "description": "IPC from the local HTTP UI on port 8080",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8080/*", "http://localhost:8080/*"]
  },
  "permissions": ["core:default", "core:window:allow-set-title"]
}
